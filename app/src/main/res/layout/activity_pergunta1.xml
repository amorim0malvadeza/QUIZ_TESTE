<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pergunta1">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#9BA7E7"
            android:text="QUE PAÍS É ESSE?"
            android:textSize="23sp" />

        <ImageView
            android:id="@+id/fotoPaís"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            tools:srcCompat="@drawable/brasil" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/opcao1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ARGENTINA" />

            <RadioButton
                android:id="@+id/opcao2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MÉXICO" />

            <RadioButton
                android:id="@+id/opcao3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GUATEMALA" />

            <RadioButton
                android:id="@+id/opcao4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BRASIL" />

        </RadioGroup>

        <Button
            android:id="@+id/btnResponder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESPONDER" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>