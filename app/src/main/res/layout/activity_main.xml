<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#6E7BC3"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="INÍCIO"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Integrante 1 (Danilo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ImageView1"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/danilo1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeIntegrantes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Danilo Silva"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rgmIntegrantes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="43945554"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Integrante 2 (Gabriel) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/gabriel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeIntegrantes2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gabriel Carvalho"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rgmIntegrantes3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="43394761"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Integrante 3 (Kauan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/kauana" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeIntegrantes3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kauan de Amorim"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rgmIntegrantes4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="44114982"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Integrante 4 melissa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/melissa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeIntegrantes4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Melissa Barbosa"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rgmIntegrantes4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="43888755"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Integrante 5 victor-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/victor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomeIntegrantes5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Victor Fereira"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rgmIntegrantes5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="43095909"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campo para digitar o Nome -->
        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:ems="10"
            android:hint="DIGITE SEU NOME"
            android:inputType="text" />

        <!-- Botões de Iniciar e Sair -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIniciar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="INICIAR QUIZ" />

            <Button
                android:id="@+id/btnEncerrar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="SAIR" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>